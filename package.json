{
  "name": "isogai-website-preview",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "npm run build:cloudflare",
    "build:github": "node scripts/build.mjs github",
    "build:cloudflare": "node scripts/build.mjs cloudflare",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "preview:cloudflare": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.local/wrangler.log wrangler dev --local --ip 127.0.0.1",
    "deploy:cloudflare": "npm run build:cloudflare && WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.local/wrangler.log wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "import:wxr": "python3 scripts/import-wxr.py"
  },
  "devDependencies": {
    "astro": "7.4.2",
    "cheerio": "1.2.0",
    "turndown": "7.2.4",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
